{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Docker Sandbox Manager",
  "version": "0.1.0",
  "identifier": "com.soarestheu.dockersandbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Docker Sandbox Manager",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERDNzRBOENEQ0NFNTkxM0EKUldRNmtlWE16YWgwM0hXMEpvMXM4VFdiQ3JnbURoY3JXTWtQREdPdnlFcCtYOFp4dkZ5cUg5enkK",
      "endpoints": [
        "https://github.com/soarestheu/docker-sandbox-manager/releases/latest/download/latest.json"
      ]
    }
  }
}
